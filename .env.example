# ============================================
# FinAdvisor - Muhit O'zgaruvchilari (.env)
# ============================================
# DIQQAT: Bu faylni .env ga nusxalang va qiymatlarni to'ldiring.
# Hech qachon .env faylni git ga push qilmang!

# --- PostgreSQL ---
POSTGRES_USER=finadvisor
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=finadvisor_db
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# --- Backend (FastAPI) ---
SECRET_KEY=your_super_secret_key_here_change_this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOWED_ORIGINS=http://localhost:3000
BACKEND_PORT=8000

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
FRONTEND_PORT=3000

# --- AI/LLM (optional; choose a model available to your OpenAI account) ---
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Payme Merchant API (fill in the approved merchant offer) ---
PAYME_MERCHANT_ID=
PAYME_MERCHANT_LOGIN=
PAYME_MERCHANT_KEY=
PAYME_SUBSCRIPTION_PRICE_TIYIN=
PAYME_SUBSCRIPTION_PERIOD_DAYS=
PAYME_SUBSCRIPTION_PLAN_CODE=configured
PAYME_CHECKOUT_URL=https://checkout.paycom.uz
PAYME_RETURN_URL=

# Internal plan-completeness score weights (must total 100; not lender criteria).
READINESS_WEIGHT_CAPEX=10
READINESS_WEIGHT_OPEX=20
READINESS_WEIGHT_SALES_TAX=20
READINESS_WEIGHT_INVESTMENT_ROI=20
READINESS_WEIGHT_LOAN=20
READINESS_WEIGHT_TAX_OUTPUT=10

# --- O'zbekiston soliq siyosati (administrator tomonidan yangilanadi) ---
UZB_VAT_RATE=12
UZB_PROFIT_TAX_RATE=15
UZB_INCOME_TAX_RATE=12
UZB_SOCIAL_TAX_RATE=12
UZB_TURNOVER_TAX_RATE=4
UZB_SIMPLIFIED_VAT_RATE=6
UZB_BASE_CALCULATION_AMOUNT=440000
UZB_TURNOVER_TAX_LIMIT_BHM=12000
