# Database
DATABASE_URL=postgresql+asyncpg://finadvisor:your_password_here@localhost:5432/finadvisor_db

# Security
SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# App
APP_ENV=development

# Uzbekistan tax policy defaults; may be overridden per deployment.
UZB_VAT_RATE=12
UZB_PROFIT_TAX_RATE=15
UZB_INCOME_TAX_RATE=12
UZB_SOCIAL_TAX_RATE=12
UZB_TURNOVER_TAX_RATE=4
UZB_SIMPLIFIED_VAT_RATE=6
UZB_BASE_CALCULATION_AMOUNT=440000
UZB_TURNOVER_TAX_LIMIT_BHM=12000

# Optional AI explanation. Set both values to enable /financial-plans/explain.
OPENAI_API_KEY=
OPENAI_MODEL=

# Payme Merchant API. Set the approved plan price in tiyin and billing period.
# Merchant login/key come from Payme; never commit real credentials.
PAYME_MERCHANT_ID=
PAYME_MERCHANT_LOGIN=
PAYME_MERCHANT_KEY=
PAYME_SUBSCRIPTION_PRICE_TIYIN=
PAYME_SUBSCRIPTION_PERIOD_DAYS=
PAYME_SUBSCRIPTION_PLAN_CODE=configured
PAYME_CHECKOUT_URL=https://checkout.paycom.uz
PAYME_RETURN_URL=

# Internal plan-completeness score weights (must total 100; not lender criteria).
READINESS_WEIGHT_CAPEX=10
READINESS_WEIGHT_OPEX=20
READINESS_WEIGHT_SALES_TAX=20
READINESS_WEIGHT_INVESTMENT_ROI=20
READINESS_WEIGHT_LOAN=20
READINESS_WEIGHT_TAX_OUTPUT=10
